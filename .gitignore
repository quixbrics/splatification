# macOS
.DS_Store

# Local backups taken before in-place edits
*.bak

# Splat captures. These are large binaries and are data, not source.
# The app loads a remote test asset (butterfly.spz) so the repo stays
# runnable without them. Drop a capture in the folder to work locally.
*.ply
*.spz
*.splat
*.ksplat
*.sog

# Exported video
*.mp4

# Audio. Test fixtures are regenerable — see NOTES.md for the ffmpeg command.
*.wav
*.mp3
*.ogg
*.m4a
*.flac
